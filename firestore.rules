rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile and private wellness data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Appointments collection
    match /appointments/{appointmentId} {
      allow read, write: if request.auth != null;
    }

    // Chat messages collection
    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    // Psychologists directory
    match /psychologists/{psychologistId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Community Sanctuary Garden & Cheer Notes
    match /community_garden/{companionId} {
      allow read: if true;
      allow write: if request.auth != null || true; // Accessible for registered and guest demo users
    }

    match /community_notes/{noteId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    // Fallback for demo / development convenience
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
